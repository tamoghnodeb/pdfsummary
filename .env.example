# ─── Google Gemini ────────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Pinecone Vector Database ─────────────────────────────────────────────────
# Free account at: https://app.pinecone.io/
# Create a Serverless index with:
#   Name: rag-chatbot (or any name)
#   Dimensions: 768
#   Metric: cosine
#   Cloud: AWS  |  Region: us-east-1
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-chatbot

# ─── Vercel Blob Storage ───────────────────────────────────────────────────────
# Auto-generated when you enable Blob Storage in Vercel dashboard.
# For local dev: run `npx vercel env pull .env.local` after linking your project,
# or create a Blob store manually in the Vercel dashboard and copy the token.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
# Your deployment URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000
# The password users enter to access the app
APP_PASSWORD=docmind-demo-2024
