# =============================================================================
# DocMind AI — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
#
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------------------
# Get a free API key at: https://aistudio.google.com/app/apikey
# Used for: text embeddings (gemini-embedding-001) and chat (gemini-2.5-flash)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# Pinecone Vector Database
# -----------------------------------------------------------------------------
# Free account at: https://app.pinecone.io
# Create a Serverless index with the following settings:
#   Name      : rag-chatbot   (or any name — set it below)
#   Dimensions: 768
#   Metric    : cosine
#   Cloud     : AWS
#   Region    : us-east-1
# -----------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-chatbot


# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# NEXTAUTH_SECRET — generate with: openssl rand -base64 32
# NEXTAUTH_URL    — your full deployment URL (no trailing slash)
#                   Local dev  : http://localhost:3000
#                   Vercel     : https://your-project.vercel.app
# APP_PASSWORD    — the password users enter to access the app
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_PASSWORD=
